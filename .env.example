# ==============================================================================
# Elevra Backend Environment Configuration
# ==============================================================================

# Server Port (Render sets this dynamically in production)
PORT=5001

# Environment Mode
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/elevra?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://singhpriyanshu608_db_user:cPOrML8fMj6WIuDs@elevracluster.xwp5brh.mongodb.net/?appName=elevraCluster
# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Verified Sender Email configured in Resend (e.g. updates@yourdomain.com or onboarding@resend.dev for testing)
VERIFIED_FROM_EMAIL=Elevra Bookings <onboarding@resend.dev>

# Coach / Admin Notification Recipient Email
COACH_EMAIL=singhpriyanshu608@gmail.com

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
# In development: http://localhost:5173
# In production on Render: https://your-elevra-app.onrender.com
CORS_ORIGIN=http://localhost:5173

# Optional: Internal Secret Key for manual retry trigger endpoint
INTERNAL_ADMIN_KEY=your_secure_internal_admin_token_here
